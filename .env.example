# Optional local PostgreSQL container. Replace CHANGE_ME before starting it.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://ehud_radar:CHANGE_ME@127.0.0.1:5433/ehud_radar

# API and frontend use separate ports from the storyboard tool.
PORT=3002
APP_ORIGIN=http://127.0.0.1:5174
NODE_ENV=development

# Generate a random secret before implementing/running authentication.
SESSION_SECRET=
# Local first-time password setup only; generate another 32-byte hex value.
# This link cannot replace an existing password and is disabled in production.
SETUP_TOKEN=

# Discovery: choose serper or tavily; keys stay in the backend.
SEARCH_PROVIDER=serper
SERPER_API_KEY=
TAVILY_API_KEY=
# Optional on-demand fit assessment. Only the free router is accepted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Production VPS deployment (compose.yaml): the public domain Caddy serves
# TLS for, and the frontend HTTPS origin the API accepts credentials from.
# Local development does not need these.
CADDY_DOMAIN=
APP_ORIGIN=http://127.0.0.1:5174
